---
import { u, asset, traducteur } from '../lib/site.js';
const { item, eager = false, lang = 'fr' } = Astro.props;
const t = traducteur(lang);
const meta = [item.constellation, item.integration && t('pose', { x: item.integration })].filter(Boolean).join(' · ');
---
<a class="carte" href={u(item.url, lang)}>
  <img src={asset(item.cover.thumb)} alt={`${item.designation} — ${item.name}`} width="900" height="600" loading={eager ? 'eager' : 'lazy'} />
  <div class="corps">
    <p class="surtitre">{item.designation}</p>
    <h3>{item.name}</h3>
    <p class="meta">{meta}</p>
  </div>
</a>
