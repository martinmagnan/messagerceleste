---
import Base from '../../layouts/Base.astro';
import ListeCarnets from '../../components/ListeCarnets.astro';
import { u, carnets, etiquettes } from '../../lib/site.js';

const annees = [...new Set(carnets.map((p) => p.date.getFullYear()))];
const principales = etiquettes.slice(0, 14);
---
<Base title="Carnets" description="Carnets d'observation et d'astrophotographie : comptes rendus de séances, essais de matériel et techniques de traitement.">
  <div class="page etroit">
    <header class="article-entete">
      <p class="surtitre">Carnets</p>
      <h1>Carnets d'observations</h1>
      <p class="discret">{carnets.length} articles, de {annees.at(-1)} à {annees[0]}.</p>
    </header>

    <ul class="etiquettes">
      {principales.map((t) => <li><a href={u(t.url)}>{t.name}<span class="nb">{t.posts.length}</span></a></li>)}
      <li><a href={u('/carnets/etiquettes/')}>Toutes les étiquettes →</a></li>
    </ul>

    {annees.map((a) => (
      <section>
        <h2 class="annee" id={String(a)}>{a}</h2>
        <ListeCarnets posts={carnets.filter((p) => p.date.getFullYear() === a)} />
      </section>
    ))}
  </div>
</Base>
