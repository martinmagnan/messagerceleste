---
// Nouveaux carnets, écrits en Markdown dans src/content/carnets/.
import Article from '../../../components/Article.astro';
import { carnets } from '../../../lib/site.js';

export function getStaticPaths() {
  return carnets.filter((p) => !p.ancien).map((post) => ({ params: { slug: post.slug }, props: { url: post.url } }));
}
const post = carnets.find((p) => p.url === Astro.props.url);
---
<Article post={post} />
