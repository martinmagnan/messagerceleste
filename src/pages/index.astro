---
import Base from '../layouts/Base.astro';
import Carte from '../components/Carte.astro';
import ListeCarnets from '../components/ListeCarnets.astro';
import { SITE, u, galerie, carnets } from '../lib/site.js';

const [vedette, ...autres] = galerie;
const recents = carnets.slice(0, 5);
---
<Base image={vedette?.cover.web}>
  {vedette && (
    <a class="vedette" href={u(vedette.url)}>
      <img
        src={u(vedette.cover.web)}
        srcset={`${u(vedette.cover.thumb)} 900w, ${u(vedette.cover.web)} 2200w`}
        sizes="100vw"
        alt={`${vedette.designation} — ${vedette.name}`}
        width={vedette.cover.width}
        height={vedette.cover.height}
        fetchpriority="high"
      />
      <div class="legende">
        <div class="page">
          <p class="surtitre">Dernière image · {vedette.designation}</p>
          <h1>{vedette.name}</h1>
          <p class="meta">{[vedette.constellation, vedette.integration && `${vedette.integration} de pose`].filter(Boolean).join(' · ')}</p>
        </div>
      </div>
    </a>
  )}

  <div class="page">
    <section class="section">
      <header>
        <h2>Galerie</h2>
        <a href={u('/galerie/')}>Toutes les images →</a>
      </header>
      <div class="grille">
        {autres.slice(0, 6).map((item) => <Carte item={item} />)}
      </div>
    </section>

    <section class="section">
      <header>
        <h2>Carnets</h2>
        <a href={u('/carnets/')}>Les {carnets.length} articles →</a>
      </header>
      <p class="intro">{SITE.description}</p>
      <ListeCarnets posts={recents} />
    </section>
  </div>
</Base>
