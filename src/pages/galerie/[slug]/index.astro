---
import Base from '../../../layouts/Base.astro';
import { u, galerie } from '../../../lib/site.js';

export function getStaticPaths() {
  return galerie.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const vues = item.images.filter((i) => i.kind === 'image');
const details = item.images.filter((i) => i.kind === 'detail');
const f = item.facts;
const court = (s) => (s ? s.split(/[,(]/)[0].trim() : null);
const faits = [
  ['Intégration', item.integration],
  ['Constellation', item.constellation],
  ['Optique', court(f['Optique'])?.replace(/^lunette /, '')],
  ['Caméra', court(f['Caméra'])],
  ['Champ', f['Champ']?.replace(/^environ /, '')],
  ['Période', f['Période']?.replace(/^du /, '')],
].filter(([, v]) => v);
const i = galerie.findIndex((g) => g.slug === item.slug);
const r = item.reperage;
const titre = `${item.designation} — ${item.name}`;
const description = `${item.subtitle}. ${[item.constellation, item.integration && item.integration + ' de pose'].filter(Boolean).join(', ')}.`;
---
<Base title={titre} description={description} image={item.cover.web}>
  <div class="page">
    <header class="fiche-titre">
      <p class="surtitre"><a href={u('/galerie/')} style="color:inherit;text-decoration:none">Galerie</a> · {item.designation}</p>
      <h1>{item.name}</h1>
      <p class="sous-titre">{item.subtitle}</p>
    </header>

    {vues.map((v, n) => (
      <figure class="vue">
        <a href={u(v.large)} title="Ouvrir en grande taille">
          <img
            src={u(v.web)}
            srcset={`${u(v.thumb)} 900w, ${u(v.web)} ${Math.min(v.width, 2200)}w`}
            sizes="(min-width: 74rem) 70rem, 100vw"
            alt={`${titre} (${v.label})`}
            width={v.width}
            height={v.height}
            loading={n === 0 ? 'eager' : 'lazy'}
          />
        </a>
        <figcaption>
          <span><strong>{v.label}</strong></span>
          <a href={u(v.large)}>Grande taille ({v.largeWidth} px) →</a>
        </figcaption>
      </figure>
    ))}

    <dl class="faits">
      {faits.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>

    {details.length > 0 && (
      <div class="details">
        {details.map((d) => (
          <figure class="vue">
            <a href={u(d.large)} title="Ouvrir à pleine résolution"><img src={u(d.thumb)} alt={`${titre} (${d.label})`} width={d.width} height={d.height} loading="lazy" /></a>
            <figcaption><span><strong>{d.label}</strong></span><a href={u(d.large)}>Pleine résolution ({d.width} × {d.height} px) →</a></figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="prose">
      {item.sections.slice(0, 1).map((s) => (
        <section>
          <h2>{s.title}</h2>
          <Fragment set:html={s.html} />
        </section>
      ))}
    </div>

    {r && (
      <section class="reperage">
        <h2>Repérage dans le ciel</h2>
        <div class="reperage-grille">
          {r.annotee && (
            <figure class="vue">
              <a href={u(r.annotee.full)} title="Ouvrir l'image annotée en grand">
                <img src={u(r.annotee.thumb)} alt={`${titre} — image annotée`} width={r.annotee.width} height={r.annotee.height} loading="lazy" />
              </a>
              <figcaption>
                <span><strong>Image annotée</strong> · objets des catalogues Messier, NGC/IC, Sharpless, Barnard et vdB, étoiles nommées</span>
                <a href={u(r.annotee.full)}>En grand →</a>
              </figcaption>
            </figure>
          )}
          {r.carte && (
            <figure class="vue">
              <a href={u(r.carte.full)} title="Ouvrir la carte en grand">
                <img src={u(r.carte.thumb)} alt={`${titre} — carte de repérage`} width={r.carte.width} height={r.carte.height} loading="lazy" />
              </a>
              <figcaption>
                <span><strong>Carte de repérage</strong> · le champ de l'image est le rectangle rouge</span>
                <a href={u(r.carte.full)}>En grand →</a>
              </figcaption>
            </figure>
          )}
        </div>
        <p class="discret">Annotation et carte générées dans PixInsight (AnnotateImage, FindingChart) à partir de la solution astrométrique de l'image.</p>
      </section>
    )}

    <div class="prose">
      {item.sections.slice(1).map((s) => (
        <section>
          <h2>{s.title}</h2>
          <Fragment set:html={s.html} />
        </section>
      ))}
      <p class="discret" style="margin-top:2.5rem">Image : {item.author}.</p>
    </div>

    <nav class="voisins" aria-label="Images voisines" style="max-width:none">
      {galerie[i + 1] && <a href={u(galerie[i + 1].url)}><small>← Image précédente</small>{galerie[i + 1].designation} — {galerie[i + 1].name}</a>}
      {galerie[i - 1] && <a class="suivant" href={u(galerie[i - 1].url)}><small>Image suivante →</small>{galerie[i - 1].designation} — {galerie[i - 1].name}</a>}
    </nav>
  </div>
</Base>
