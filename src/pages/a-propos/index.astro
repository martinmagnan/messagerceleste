---
import Base from '../../layouts/Base.astro';
import { SITE, u, galerie, carnets } from '../../lib/site.js';

const anciens = carnets.filter((p) => p.ancien);
const annees = anciens.map((p) => p.date.getFullYear());
---
<Base title="À propos" description={`À propos de ${SITE.title}, le carnet d'astrophotographie de ${SITE.author}.`}>
  <div class="page etroit">
    <header class="article-entete">
      <p class="surtitre">À propos</p>
      <h1>{SITE.title}</h1>
    </header>
    <div class="prose">
      <p class="intro">« {SITE.description} »</p>
      <p>
        C'est ainsi que ce carnet se présentait à ses débuts, en décembre 2007. {SITE.title} est le site
        d'astrophotographie de {SITE.author}.
      </p>

      <h2>La galerie</h2>
      <p>
        La <a href={u('/galerie/')}>galerie</a> réunit {galerie.length} images récentes du ciel profond. Elles sont
        acquises à distance, depuis un site d'observation au Texas, avec une lunette SharpStar 94EDPH et une caméra
        monochrome QHY268M, puis traitées dans PixInsight. Chaque image est accompagnée de sa fiche : description de
        l'objet, détail des poses, étapes du traitement.
      </p>

      <h2>Les carnets</h2>
      <p>
        Les <a href={u('/carnets/')}>carnets</a> reprennent les {anciens.length} articles publiés
        de {Math.min(...annees)} à {Math.max(...annees)} sur l'ancien blog : comptes rendus de séances, essais de
        matériel, techniques de traitement. Ils sont conservés tels quels, à leur adresse d'origine.
      </p>

      <h2>Utilisation des images</h2>
      <p>Les images et les textes de ce site sont la propriété de leur auteur. Merci de demander avant de les réutiliser.</p>
    </div>
  </div>
</Base>
