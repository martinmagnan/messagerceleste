---
// Billets écrits en Markdown dans src/content/carnets/.
import Article from '../../../../components/Article.astro';
import { carnets } from '../../../../lib/site.js';

export function getStaticPaths() {
  return carnets.filter((p) => !p.fichier).map((post) => ({ params: { slug: post.slug }, props: { url: post.url } }));
}
---
<Article url={Astro.props.url} lang="en" />
