---
// Relais anglais pour les anciennes archives mensuelles Blogger : /AAAA_MM_01_archive.html
import Relais from '../../components/Relais.astro';
import { carnets } from '../../lib/site.js';

export function getStaticPaths() {
  const mois = new Set(carnets.filter((p) => p.ancien).map((p) => `${p.year}_${p.month}`));
  return [...mois].map((m) => ({ params: { archive: `${m}_01_archive` }, props: { annee: m.slice(0, 4) } }));
}
const { annee } = Astro.props;
---
<Relais vers={`/carnets/#${annee}`} titre={`Journal, ${annee}`} lang="en" />
