---
import Base from '../layouts/Base.astro';
import { u } from '../lib/site.js';
---
<Base title="Page introuvable" noindex autreLangue={false}>
  <div class="page etroit">
    <header class="article-entete">
      <p class="surtitre">Erreur 404</p>
      <h1>Cette page s'est perdue dans le ciel</h1>
      <p class="discret">L'adresse demandée n'existe pas ou n'existe plus.</p>
    </header>
    <p><a href={u('/galerie/')}>Voir la galerie</a> · <a href={u('/carnets/')}>Parcourir les carnets</a></p>
    <p lang="en" class="discret" style="margin-top:2rem">This page does not exist, or no longer exists. <a href={u('/galerie/', 'en')}>See the gallery</a> · <a href={u('/carnets/', 'en')}>Browse the journal</a></p>
  </div>
</Base>
